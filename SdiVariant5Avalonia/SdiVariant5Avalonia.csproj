<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>SdiVariant5</RootNamespace>
    <AssemblyName>SdiVariant5Avalonia</AssemblyName>
  </PropertyGroup>

  <!-- Классы с логикой общие с Windows-версией (папка ../SdiVariant5), здесь они не копируются. -->
  <ItemGroup>
    <Compile Include="..\SdiVariant5\SdiVariant5\Matrix.cs" Link="Shared\Matrix.cs" />
    <Compile Include="..\SdiVariant5\SdiVariant5\TaskOptions.cs" Link="Shared\TaskOptions.cs" />
    <Compile Include="..\SdiVariant5\SdiVariant5\Variant5Solver.cs" Link="Shared\Variant5Solver.cs" />
    <Compile Include="..\SdiVariant5\SdiVariant5\Variant5Report.cs" Link="Shared\Variant5Report.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.3" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.3" />
  </ItemGroup>

</Project>
