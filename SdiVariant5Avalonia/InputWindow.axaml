<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="SdiVariant5.InputWindow"
        Title="Ввод исходных данных"
        Width="700" Height="500" MinWidth="620" MinHeight="340"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <DockPanel Margin="12">
        <StackPanel DockPanel.Dock="Top" Spacing="8">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="Строк:" VerticalAlignment="Center" />
                <NumericUpDown x:Name="RowsBox" Width="110" Increment="1" FormatString="0"
                               ParsingNumberStyle="Integer" VerticalContentAlignment="Center" ValueChanged="Size_ValueChanged" />
                <TextBlock Text="Столбцов:" VerticalAlignment="Center" Margin="8,0,0,0" />
                <NumericUpDown x:Name="ColumnsBox" Width="110" Increment="1" FormatString="0"
                               ParsingNumberStyle="Integer" VerticalContentAlignment="Center" ValueChanged="Size_ValueChanged" />
                <Button Content="Обнулить строку" Margin="16,0,0,0" Click="ClearRow_Click" />
                <Button Content="Обнулить всё" Click="ClearAll_Click" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="Случайные числа от" VerticalAlignment="Center" />
                <NumericUpDown x:Name="MinBox" Width="110" Increment="1" FormatString="0"
                               ParsingNumberStyle="Integer" VerticalContentAlignment="Center" Minimum="-1000" Maximum="1000" Value="-3" />
                <TextBlock Text="до" VerticalAlignment="Center" />
                <NumericUpDown x:Name="MaxBox" Width="110" Increment="1" FormatString="0"
                               ParsingNumberStyle="Integer" VerticalContentAlignment="Center" Minimum="-1000" Maximum="1000" Value="3" />
                <Button Content="Заполнить случайно" Click="Random_Click" />
            </StackPanel>
        </StackPanel>

        <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8">
                <Button Content="OK" MinWidth="90" HorizontalContentAlignment="Center" Click="Ok_Click" />
                <Button Content="Отмена" MinWidth="90" HorizontalContentAlignment="Center" IsCancel="True"
                        Click="Cancel_Click" />
            </StackPanel>
            <TextBlock x:Name="HintText" VerticalAlignment="Center" TextWrapping="Wrap" />
        </DockPanel>

        <Border Margin="0,10,0,0" BorderBrush="#D5D8DD" BorderThickness="1" Background="White">
            <ScrollViewer x:Name="MatrixScroll"
                          HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" />
        </Border>
    </DockPanel>
</Window>
