<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="SdiVariant5.AboutWindow"
        Title="О программе"
        SizeToContent="WidthAndHeight" CanResize="False"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <StackPanel Margin="24,20" Spacing="12" Width="380">
        <TextBlock Text="SDI-приложение «Двумерный массив»" FontSize="17" FontWeight="Bold" />
        <TextBlock TextWrapping="Wrap">
            <Run Text="Лабораторная работа «Создание SDI-приложения»" />
            <LineBreak />
            <Run Text="Вариант 5 · версия 1.0 (Avalonia)" />
        </TextBlock>
        <TextBlock TextWrapping="Wrap"
                   Text="Проверка наличия строки из одних нулей и подсчёт нулевых элементов в чётных столбцах." />
        <TextBlock Text="Выполнил: Герасимов Е. А., группа А-19-24" />
        <Button Content="OK" MinWidth="90" HorizontalAlignment="Right" HorizontalContentAlignment="Center"
                IsDefault="True" IsCancel="True" Click="Ok_Click" />
    </StackPanel>
</Window>
