<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="SdiVariant5.ResultWindow"
        Title="Результат"
        Width="700" Height="560" MinWidth="560" MinHeight="420"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Window.Styles>
        <Style Selector="Border.swatch">
            <Setter Property="Width" Value="16" />
            <Setter Property="Height" Value="16" />
            <Setter Property="BorderBrush" Value="#8A9099" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Window.Styles>

    <DockPanel Margin="12">
        <Button DockPanel.Dock="Bottom" Content="Закрыть" MinWidth="90" HorizontalAlignment="Right"
                HorizontalContentAlignment="Center" Margin="0,10,0,0"
                IsDefault="True" IsCancel="True" Click="Close_Click" />

        <TextBox x:Name="ReportBox" DockPanel.Dock="Bottom" Height="200" Margin="0,8,0,0"
                 IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                 FontFamily="Menlo, Consolas, Courier New" FontSize="13" />

        <WrapPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
            <StackPanel x:Name="ZeroRowLegend" Orientation="Horizontal" Spacing="6" Margin="0,0,20,0">
                <Border x:Name="ZeroRowSwatch" Classes="swatch" />
                <TextBlock Text="строка из одних нулей" VerticalAlignment="Center" />
            </StackPanel>
            <StackPanel x:Name="EvenColumnLegend" Orientation="Horizontal" Spacing="6" Margin="0,0,20,0">
                <Border x:Name="EvenColumnSwatch" Classes="swatch" />
                <TextBlock Text="чётный столбец" VerticalAlignment="Center" />
            </StackPanel>
            <StackPanel x:Name="CountedZeroLegend" Orientation="Horizontal" Spacing="6">
                <Border x:Name="CountedZeroSwatch" Classes="swatch" />
                <TextBlock Text="ноль в чётном столбце (учтён)" VerticalAlignment="Center" />
            </StackPanel>
        </WrapPanel>

        <Border BorderBrush="#D5D8DD" BorderThickness="1" Background="White">
            <ScrollViewer x:Name="MatrixScroll"
                          HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" />
        </Border>
    </DockPanel>
</Window>
